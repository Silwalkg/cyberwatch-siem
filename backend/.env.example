# CyberWatch SIEM - Environment Variables
# Copy this file to .env and fill in real values before running.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=change-this-to-a-long-random-string-before-running

# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./cyberwatch.db
# In Docker, the DB is stored on a named volume so it survives restarts:
# DATABASE_URL=sqlite:////app/data/cyberwatch.db

# Set to "true" to allow login with any password (demo/dev only).
# Must be explicitly enabled — never leave on in production.
DEMO_MODE=false

# Comma-separated list of allowed frontend origins.
# Defaults to "*" (all) when not set — fine for local dev, lock down for production.
# CORS_ORIGINS=https://siem.example.com
