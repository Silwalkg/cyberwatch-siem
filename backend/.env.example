# CyberWatch SIEM - Environment Variables
# Copy this file to .env and fill in real values before running.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=change-this-to-a-long-random-string-before-running

DATABASE_URL=sqlite:///./cyberwatch.db

# Set to "true" to allow login with any password (demo/dev only).
# Must be explicitly enabled — never leave on in production.
DEMO_MODE=false
